# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+asyncpg://biletflow:biletflow@localhost:5432/biletflow

# Minimum 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

ENVIRONMENT=local
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=60
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Mailpit captures development emails at http://localhost:8025.
SMTP_ENABLED=true
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
EMAIL_FROM=noreply@biletflow.test
WEB_BASE_URL=http://localhost:5173
# For an external SMTP provider, use STARTTLS and set these locally:
SMTP_USERNAME=
SMTP_PASSWORD=
PAID_ACTIVATION_FEE_KZT=15000
