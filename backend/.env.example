# For running the API on your machine: cp .env.example .env
# `docker compose up` works without this file; see docker-compose.yml for what it can override.
ENVIRONMENT=local
LOG_LEVEL=INFO
# false gives readable logs for local development
LOG_JSON=false
WEB_BASE_URL=http://localhost:5173
# Public URL of this API; Campaign QR codes link to {PUBLIC_BASE_URL}/c/<token>. Use https in production.
PUBLIC_BASE_URL=http://localhost:8000

DATABASE_URL=postgresql+asyncpg://biletflow:biletflow@localhost:5432/biletflow
# Used by pytest only. The database name must end in _test: the suite wipes it.
TEST_DATABASE_URL=postgresql+asyncpg://biletflow:biletflow@localhost:5432/biletflow_test

# Required, at least 32 characters. Generate with: openssl rand -hex 32
# Values starting with dev-only- are rejected when ENVIRONMENT=production.
JWT_SECRET=dev-only-jwt-secret-0123456789abcdef0123
TICKET_SIGNING_SECRET=dev-only-ticket-secret-0123456789abcdef

# P6 payments: all simulated. platform_settings rows (admin, P11) override these defaults.
# Amounts are in tiyn (1 KZT = 100 tiyn).
ACTIVATION_FEE_AMOUNT=1000000
PROCESSING_FEE_PERCENT=3
PAYOUT_DELAY_DAYS=3
PAYMENT_SIMULATION_ENABLED=true

ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14
EMAIL_VERIFY_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# Attempts per window on login, password reset and registration.
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_PER_ACCOUNT=10
AUTH_RATE_LIMIT_PER_IP=100

# Email. Leave SMTP_HOST and SMTP_PORT unset to use MailHog: Docker reaches it at mailhog:1025, and
# an API started on your machine at localhost:1025. MailHog needs no login and sends nothing out.
EMAIL_FROM=noreply@example.com
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
# To send real email, for example through Gmail (see "Send real email" in the README):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your16charapppassword
# EMAIL_FROM=you@gmail.com
# Notification emails are sent by the worker, which retries a failed one this many times.
NOTIFICATION_MAX_EMAIL_ATTEMPTS=5

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=biletflow
S3_SECRET_KEY=biletflow-dev
S3_BUCKET=biletflow

# Accounts created by scripts/seed.py
SEED_ADMIN_EMAIL=admin@example.com
SEED_ORGANIZER_EMAIL=organizer@example.com
SEED_PASSWORD=ChangeMe-Demo-123
