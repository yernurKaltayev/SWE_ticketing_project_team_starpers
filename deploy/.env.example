# cp .env.example .env, then replace every value marked CHANGE. Never commit .env.
# Public host name. Without a domain, <ip-with-dashes>.sslip.io works, e.g. 1-2-3-4.sslip.io.
DOMAIN=CHANGE.example.com
ENVIRONMENT=production
WEB_BASE_URL=https://CHANGE.example.com
PUBLIC_BASE_URL=https://CHANGE.example.com
AUTH_COOKIE_SECURE=true

# Generate each with: openssl rand -hex 32  (dev-only- values are refused in production)
JWT_SECRET=CHANGE
TICKET_SIGNING_SECRET=CHANGE
POSTGRES_PASSWORD=CHANGE
MINIO_ROOT_USER=biletflow
MINIO_ROOT_PASSWORD=CHANGE

# Password for admin@example.com / organizer@example.com created by scripts.seed.
SEED_PASSWORD=CHANGE

# Email. Unset SMTP_HOST keeps MailHog (nothing leaves the server, so new users cannot verify).
EMAIL_FROM=noreply@CHANGE.example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your16charapppassword

# Phone verification through Telegram (see backend/README.md). Empty keeps it off.
# The bare token from @BotFather, no quotes or <>; the bot's username without @.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
