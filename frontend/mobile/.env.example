# Replace with this computer's reachable LAN IPv4 address for physical phones.
# Android emulator can use http://10.0.2.2:8000; localhost on a phone means the phone itself.
EXPO_PUBLIC_API_ORIGIN=http://192.168.1.10:8000

# Optional HTTPS origin for public links and relative event artwork.
# Defaults to EXPO_PUBLIC_API_ORIGIN for deployments that serve both on one origin.
EXPO_PUBLIC_WEB_ORIGIN=

# Optional native identifiers for signed development or production builds.
# Set both the relevant identifier and the HTTPS origin to configure verified app links.
BILETFLOW_IOS_BUNDLE_ID=
BILETFLOW_ANDROID_PACKAGE=
