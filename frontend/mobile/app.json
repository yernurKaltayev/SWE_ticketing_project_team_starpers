{
  "expo": {
    "name": "BiletFlow",
    "slug": "biletflow",
    "owner": "biletflow-team",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "BiletFlow uses the camera to scan ticket QR codes at the entrance.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "BiletFlow uses your photos to set an event cover image.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "biletflow",
    "extra": {
      "eas": {
        "projectId": "a6b24511-4ef6-46f6-8f30-47f9ac8cbdcf"
      }
    }
  }
}
