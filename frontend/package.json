{
  "name": "biletflow-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "web",
    "mobile",
    "shared"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace @biletflow/web",
    "dev:mobile": "npm run start --workspace @biletflow/mobile",
    "generate:api": "node scripts/api-types.mjs",
    "check:api": "node scripts/api-types.mjs --check",
    "lint": "oxlint --deny-warnings web/src web/vite.config.ts mobile/App.tsx mobile/src shared/src shared/tests scripts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "build:web": "npm run build --workspace @biletflow/web",
    "export:mobile": "npm run export --workspace @biletflow/mobile",
    "check": "npm run check:api && npm run lint && npm run typecheck && npm test && npm run build:web"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "openapi-typescript": "^7.0.0",
    "oxlint": "^1.89.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  },
  "msw": {
    "workerDirectory": [
      "web/public"
    ]
  }
}
